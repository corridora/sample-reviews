# Published 2026-10-11 · Updated 2026-10-11
# ./setup configure stores these in Git-ignored, owner-only .local files.
SAMPLE_MODE=local
PORT=4102
CORRIDORA_TARGET=own
CORRIDORA_OTLP_ENDPOINT=https://ingest.corridora.com
CORRIDORA_INGEST_KEY=
CORRIDORA_RUM_KEY=
CORRIDORA_RUM_SCRIPT_URL=https://rum.corridora.com/corridora-rum.js
OTEL_SERVICE_NAME=sample-reviews-api
OTEL_SERVICE_NAMESPACE=corridora-samples.reviews
DEPLOYMENT_ENVIRONMENT=development
DEMO_CONTROL_TOKEN=
DEMO_DAILY_START_UTC=13:20
DEMO_WINDOW_SECONDS=600
ENABLE_PROVIDER_FORWARDING=false
ENABLE_SYNTHETICS=false
# When cloud synthetics are enabled, setup installs the selected repo's daily runner.
SYNTHETIC_GITHUB_REPOSITORY=
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
STACK_PREFIX=sample-reviews
# Only an explicitly selected DEDICATED config secret; blank creates an owned one.
EXISTING_SECRET_ARN=
RECOMMENDER_URL=
DOWNSTREAM_AUTH_TOKEN=
PUBLIC_ORIGIN=
# Backend build identity is a source content digest computed by ./setup.
# SERVICE_VERSION is never changed to simulate a deployment regression.
# Browser tests can read a real local distribution; never use a fake browser tracer.
# RUM_BUNDLE_PATH=/absolute/path/corridora-rum.js
